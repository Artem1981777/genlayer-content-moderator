import { readFileSync, writeFileSync } from "node:fs";
import { createClient, createAccount } from "genlayer-js";
import { testnetBradbury } from "genlayer-js/chains";
import { TransactionStatus } from "genlayer-js/types";

const operator = createAccount(process.env.PRIVATE_KEY);
const authorKey = readFileSync(process.env.HOME + "/genlayer/escrow-dapp/seller-key.txt", "utf8").trim();
const author = createAccount(authorKey);
const cOp = createClient({ chain: testnetBradbury, account: operator });
const cAuthor = createClient({ chain: testnetBradbury, account: author });
const ADDRESS = readFileSync("registry-contract.txt", "utf8").trim();
const HOST = "https://artem1981777.github.io";
const DIR = "/genlayer-content-moderator/fixtures/";
const U_BORDER = HOST + DIR + "borderline.html";
const U_BENIGN = HOST + DIR + "benign.html";
const U_MILD = HOST + DIR + "mild.html";
const U_SCAM = HOST + DIR + "scam.html";
const RULES = "No scams, fraud, or financial schemes. No requests for private keys, wallet seed phrases, or credentials. No spam, no harassment, no hate speech, no violence.";
const MIN_STAKE = 1000000000000n;
const REPORT_BOND = 1000000000000n;
const APPEAL_BOND = 2000000000000n;
const POOL_FUND = 5000000000000n;

const results = [];
const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
function retriable(msg){ msg=String(msg||"").toLowerCase(); return msg.includes("-32005")||msg.includes("capacity")||msg.includes("rate limit")||msg.includes("exceeds defined limit")||msg.includes("consensus contract")||msg.includes("evm tx"); }

async function waitFinal(client, hash, label, maxIters){
  for(let i=0;i<(maxIters||60);i++){
    let tx=null;
    try{ tx=await client.getTransaction({hash}); }catch(e){ await sleep(5000); continue; }
    const rn=String(tx?.txExecutionResultName||"");
    if(rn==="FINISHED"||rn==="FINISHED_WITH_RETURN") return tx;
    if(/ERROR|REVERT|ROLL|DISAGREE|UNDETERMIN/i.test(rn)) throw new Error("exec failed "+label+": "+rn);
    if(i%5===0) console.log("  waiting finality "+label+" ("+(rn||"pending")+")");
    await sleep(6000);
  }
  throw new Error("timeout finality "+label);
}

async function w(client, fn, args, value){
  for(let attempt=1;attempt<=8;attempt++){
    try{
      const hash=await client.writeContract({address:ADDRESS,functionName:fn,args:args||[],value:value||0n});
      await client.waitForTransactionReceipt({hash,status:TransactionStatus.ACCEPTED,retries:400});
      await waitFinal(client,hash,fn,60);
      console.log("  "+fn+" tx:",hash);
      return hash;
    }catch(e){
      const msg=e?.message||String(e);
      console.log("  "+fn+" attempt "+attempt+": "+msg.slice(0,90));
      if((retriable(msg)||/timeout|not_voted|fetch failed|finished_with_error/i.test(msg))&&attempt<8){ await sleep(12000); continue; }
      throw e;
    }
  }
}

async function readJson(client, fn, args){
  const raw=await client.readContract({address:ADDRESS,functionName:fn,args:args||[]});
  if(typeof raw==="string"){ if(raw==="") return null; try{ return JSON.parse(raw); }catch(e){ return raw; } }
  return raw;
}
async function newestId(){ const ids=await readJson(cOp,"get_item_ids",[]); return Array.isArray(ids)?ids[ids.length-1]:null; }

async function expectRevert(client, fn, args, value, label){
  console.log("EXPECT-REVERT ["+label+"] "+fn);
  let hash;
  try{
    hash=await client.writeContract({address:ADDRESS,functionName:fn,args:args||[],value:value||0n});
  }catch(e){
    console.log("  reverted at submit (PASS): "+String(e?.message||e).slice(0,110));
    results.push({test:label,pass:true,how:"submit-revert"});
    return true;
  }
  try{
    await client.waitForTransactionReceipt({hash,status:TransactionStatus.ACCEPTED,retries:400});
    const tx=await waitFinal(client,hash,label,60);
    console.log("  !!! DID NOT REVERT (FAIL) "+label+": "+String(tx?.txExecutionResultName)+" tx "+hash);
    results.push({test:label,pass:false,how:"executed",tx:hash});
    return false;
  }catch(e){
    console.log("  reverted on-chain (PASS): "+String(e?.message||e).slice(0,110));
    results.push({test:label,pass:true,how:"exec-revert"});
    return true;
  }
}

function expect(cond, label){
  console.log((cond?"PASS":"FAIL")+" ["+label+"]");
  results.push({test:label,pass:!!cond,how:"assert"});
  return !!cond;
}

async function ensureGas(minWei, topupWei){
  const b=await cOp.getBalance({address:author.address});
  console.log("author balance:",b.toString());
  if(b<minWei){
    let h;
    try{ h=await cOp.sendTransaction({to:author.address,value:topupWei}); }
    catch(e){ h=await cOp.sendTransaction({account:operator,to:author.address,value:topupWei}); }
    console.log("topup tx:",h);
    for(let i=0;i<25;i++){ const nb=await cOp.getBalance({address:author.address}); if(nb>=minWei){ console.log("author funded:",nb.toString()); break; } await sleep(6000); }
  }
}

async function mkItem(){ await w(cOp,"create_item",[RULES],0n); const id=await newestId(); console.log("  item_id:",id); return id; }

async function main(){
  console.log("=== v1.2 FIX TESTS ===");
  console.log("registry:",ADDRESS);
  console.log("owner:",operator.address," author:",author.address);
  if(operator.address.toLowerCase()===author.address.toLowerCase()) throw new Error("operator and author must differ");
  await ensureGas(10000000000000000n,30000000000000000n);
  await w(cOp,"fund_pool",[],POOL_FUND);

  // pre-clean stale URL bindings so the suite is re-runnable
  for(const u of [U_BORDER,U_BENIGN,U_MILD,U_SCAM]){
    try{ await w(cOp,"release_url",[u],0n); }catch(e){ console.log("  pre-release "+u+":",String(e?.message||e).slice(0,60)); }
  }

  // ---- TEST A: re-roll (#1) + early non-owner enforce (#2 neg) ----
  console.log("---- TEST A: re-roll / early non-owner enforce ----");
  const idA=await mkItem();
  await w(cAuthor,"ingest",[idA,U_BORDER],MIN_STAKE);
  await w(cAuthor,"moderate",[idA],0n); // first pass on 'ingested' by non-owner allowed (#1+)
  let a=await readJson(cOp,"get_item",[idA]);
  expect(a.status==="moderated","A: first-pass moderate by non-owner allowed (#1)");
  await expectRevert(cAuthor,"moderate",[idA],0n,"A: re-roll by non-owner on moderated blocked (#1)");
  await expectRevert(cAuthor,"enforce",[idA],0n,"A: non-owner enforce before timeout blocked (#2)");
  await w(cOp,"enforce",[idA],0n);

  // ---- TEST B: report on enforced item (#3) ----
  console.log("---- TEST B: report on enforced ----");
  const idB=await mkItem();
  await w(cAuthor,"ingest",[idB,U_BENIGN],MIN_STAKE);
  await w(cOp,"moderate",[idB],0n);
  await w(cOp,"enforce",[idB],0n);
  let b=await readJson(cOp,"get_item",[idB]);
  expect(b.status==="enforced","B: item enforced");
  await expectRevert(cOp,"report",[idB],REPORT_BOND,"B: report on enforced item rejected (#3)");

  // ---- TEST C: duplicate URL (#7) + partial FLAG (#5) + limited masking (#9) ----
  console.log("---- TEST C: duplicate URL / partial FLAG / masking ----");
  const idC1=await mkItem();
  await w(cAuthor,"ingest",[idC1,U_MILD],MIN_STAKE);
  const idC2=await mkItem();
  await expectRevert(cAuthor,"ingest",[idC2,U_MILD],MIN_STAKE,"C: duplicate active URL rejected (#7)");
  await w(cOp,"moderate",[idC1],0n);
  let c=await readJson(cOp,"get_item",[idC1]);
  console.log("  idC1 verdict:",c.verdict,"| axes:",JSON.stringify(c.axis_scores));
  await w(cOp,"enforce",[idC1],0n);
  c=await readJson(cOp,"get_item",[idC1]);
  console.log("  idC1 stake_outcome:",c.stake_outcome,"| forfeited:",c.forfeited,"| enforcement:",c.enforcement_action);
  if(c.verdict==="FLAG"){
    expect((c.stake_outcome||"").indexOf("partial_forfeit")>=0,"C: FLAG partial forfeit outcome (#5)");
    expect(String(c.forfeited)===String(MIN_STAKE/2n),"C: FLAG forfeited == 50% stake (#5)");
    expect(String(c.content||"").indexOf("[limited]")===0,"C: FLAG content masked as limited (#9)");
  } else {
    console.log("  (C: verdict "+c.verdict+", FLAG assertions skipped)");
    results.push({test:"C: FLAG partial forfeit (#5)",pass:null,how:"skipped-verdict-"+c.verdict});
  }

  // ---- TEST D: reclaim before timeout (#2 neg) + REMOVE masking (#9) ----
  console.log("---- TEST D: reclaim before timeout / REMOVE masking ----");
  const idD=await mkItem();
  await w(cAuthor,"ingest",[idD,U_SCAM],MIN_STAKE);
  await w(cOp,"moderate",[idD],0n);
  let d=await readJson(cOp,"get_item",[idD]);
  console.log("  idD verdict:",d.verdict);
  await w(cOp,"enforce",[idD],0n);
  d=await readJson(cOp,"get_item",[idD]);
  if(d.verdict==="REMOVE") expect(String(d.content||"").indexOf("[content removed")===0,"D: REMOVE content masked (#9)");
  if(d.status==="enforced"){
    await w(cAuthor,"appeal",[idD,"Author: please re-review, legitimate content."],APPEAL_BOND);
    await expectRevert(cAuthor,"reclaim_appeal",[idD],0n,"D: reclaim before appeal timeout rejected (#2)");
    await w(cOp,"resolve_appeal",[idD],0n);
  } else {
    console.log("  (D: not enforced, appeal path skipped)");
  }

  console.log("=== SUMMARY ===");
  let pass=0,fail=0,skip=0;
  for(const r of results){ if(r.pass===true)pass++; else if(r.pass===false)fail++; else skip++; console.log((r.pass===true?"PASS":r.pass===false?"FAIL":"SKIP")+"  "+r.test+"  ("+r.how+")"); }
  console.log("TOTALS: pass="+pass+" fail="+fail+" skip="+skip);
  writeFileSync("registry-v12-tests.json",JSON.stringify({address:ADDRESS,results,totals:{pass,fail,skip}},null,2));
  if(fail>0){ console.log("=== TESTS FAILED ==="); process.exit(1); }
  console.log("=== ALL v1.2 FIX TESTS PASSED ===");
}
main().catch((e)=>{ console.error("FATAL:",e?.message||e); process.exit(1); });
